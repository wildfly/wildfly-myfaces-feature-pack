<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.wildfly</groupId>
        <artifactId>wildfly-myfaces-feature-pack-parent</artifactId>
        <version>2.0.5-SNAPSHOT</version>
    </parent>

    <artifactId>wildfly-myfaces-feature-pack</artifactId>
    <name>MyFaces 4.0 Support for WildFly - Feature Pack</name>
    <description>MyFaces 4.0 Support for WildFly - Feature Pack</description>

    <packaging>pom</packaging>

    <dependencies>
         <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>wildfly-myfaces-feature-pack-galleon-content</artifactId>
            <type>pom</type>
        </dependency>
        <dependency>
            <groupId>org.wildfly</groupId>
            <artifactId>wildfly-ee-10-feature-pack</artifactId>
            <type>zip</type>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <properties>
        <common.resources.directory>${basedir}/../galleon-content/src/main/resources</common.resources.directory>
        <license.directory>${project.build.directory}/resources/packages/docs.licenses/content/docs/licenses</license.directory>
    </properties>
    
    <build>                
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-common-feature-pack-resources</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${basedir}/target/resources</outputDirectory>
                            <escapeString>\</escapeString>
                            <resources>
                                <resource>
                                    <directory>${common.resources.directory}</directory>
                                    <excludes>
                                        <exclude>modules/**/module.xml</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${common.resources.directory}</directory>
                                    <includes>
                                        <include>modules/**/module.xml</include>
                                    </includes>
                                    <filtering>true</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-feature-pack-resources</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${basedir}/target/resources</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${basedir}/src/main/resources</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
             <plugin>
                <groupId>org.wildfly.maven.plugins</groupId>
                <artifactId>licenses-plugin</artifactId>
                <version>2.4.6.Final</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>update-licenses-xml</id>
                        <goals>
                            <goal>insert-versions</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <generateVersionProperty>true</generateVersionProperty>
                            <sortByGroupIdAndArtifactId>true</sortByGroupIdAndArtifactId>
                            <licensesConfigFiles>
                                <licensesConfigFile>${basedir}/target/resources/license/licenses.xml</licensesConfigFile>
                            </licensesConfigFiles>
                            <licensesOutputFile>${license.directory}/wildfly-myfaces-feature-pack-licenses.xml</licensesOutputFile>
                            <excludedArtifacts>wildfly-ee-galleon-pack|wildfly-myfaces-feature-pack-galleon-content\z</excludedArtifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.wildfly.galleon-plugins</groupId>
                <artifactId>wildfly-galleon-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>wildfly-myfaces-feature-pack-build</id>
                        <goals>
                            <goal>build-user-feature-pack</goal>
                        </goals>
                        <phase>compile</phase>
                        <configuration>
                            <resources-dir>${basedir}/target/resources</resources-dir>
                            <release-name>WildFly MyFaces Feature Pack</release-name>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Release profile. Activated by the maven-release-plugin during
            release:prepare / release:perform, which pass -Prelease,central-release
            (see preparationProfiles / releaseProfiles in the root pom).

            Why this lives in the feature-pack module rather than the root:
            jreleaser-maven-plugin's full-release goal is not an aggregator, so a
            phase binding fires when *this* module reaches the phase. The aggregator
            root is built first in the reactor, so binding there runs JReleaser
            before the feature pack ZIP exists. Binding to this module's deploy phase
            guarantees the ZIP (built in the compile phase above) is present when
            JReleaser attaches and signs it. JReleaser resolves its basedir to the
            reactor root, so the git repo, tag, and the glob below all resolve
            against the project root regardless of which module triggers it.

            Division of responsibilities:
              * GPG signing of the Maven artifacts and publishing to Maven Central
                are handled by jboss-parent's 'central-release' profile
                (maven-gpg-plugin + central-publishing-maven-plugin), activated
                reactor-wide via releaseProfiles.
              * JReleaser (below) creates the GitHub release with a generated
                changelog and attaches + signs the feature pack ZIP.

            Nothing sensitive is hardcoded; every value is sourced externally:
              * GitHub owner / name  -> auto-detected from the git 'origin' remote
              * GitHub token         -> JRELEASER_GITHUB_TOKEN environment variable
              * GPG passphrase / keys-> JRELEASER_GPG_PASSPHRASE / _PUBLIC_KEY / _SECRET_KEY
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jreleaser</groupId>
                        <artifactId>jreleaser-maven-plugin</artifactId>
                        <version>${version.org.jreleaser}</version>
                        <configuration>
                            <jreleaser>
                                <project>
                                    <copyright>WildFly Community</copyright>
                                </project>
                                <signing>
                                    <!-- Sign only on releases (skips SNAPSHOT versions). -->
                                    <active>RELEASE</active>
                                    <pgp>
                                        <armored>true</armored>
                                    </pgp>
                                </signing>
                                <release>
                                    <github>
                                        <!-- owner/name resolved from the git 'origin' remote. -->
                                        <tagName>${project.version}</tagName>
                                        <releaseName>${project.version}</releaseName>
                                        <overwrite>false</overwrite>
                                        <!-- Mark non-Final qualifiers (Alpha/Beta/CR/...) as prereleases. -->
                                        <prerelease>
                                            <pattern>.*[-.](Alpha|Beta|CR|RC|Milestone|Preview).*</pattern>
                                        </prerelease>
                                        <changelog>
                                            <formatted>ALWAYS</formatted>
                                            <preset>conventional-commits</preset>
                                        </changelog>
                                    </github>
                                </release>
                                <files>
                                    <!-- Attach (and sign) the built feature pack as a release asset.
                                         Path is relative to the reactor root (see basedir note above). -->
                                    <globs>
                                        <glob>
                                            <pattern>myfaces-feature-pack/target/*.zip</pattern>
                                        </glob>
                                    </globs>
                                </files>
                            </jreleaser>
                        </configuration>
                        <executions>
                            <execution>
                                <id>jreleaser-full-release</id>
                                <!-- deploy phase of this module: runs after the feature pack ZIP is
                                     built and inside the release:perform checkout. -->
                                <phase>deploy</phase>
                                <goals>
                                    <goal>full-release</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
